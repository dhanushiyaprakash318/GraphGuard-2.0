# Application
APP_NAME=GraphGuard 2.0
APP_VERSION=1.0.0
LOG_LEVEL=INFO
MODEL_VERSION=graphguard-lgbm-v1
MODEL_PATH=app/models/graphguard_prediction_bundle.joblib
BATCH_MAX_SIZE=100
MAX_REQUEST_BODY_BYTES=2097152

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database (Compose overrides this to the db service)
DATABASE_URL=postgresql+psycopg2://graphguard:graphguard@localhost:5432/graphguard

# -----------------------------------------------------------------------------
# Microsoft Fabric (required for live Fabric status = connected)
# Copy this file to .env and fill values locally. NEVER commit .env.
# Workspace: GraphGuard_Fabric_Analytics
# Lakehouse: GraphGuard_Lakehouse
# Eventstream: ES_GraphGuard_Lakehouse
# -----------------------------------------------------------------------------
FABRIC_SQL_ENDPOINT=
# Example: xxxxxxxx.datawarehouse.fabric.microsoft.com
FABRIC_DATABASE=
# Usually the Lakehouse / SQL analytics database name, e.g. GraphGuard_Lakehouse
FABRIC_TENANT_ID=
# Entra Directory (tenant) ID
FABRIC_CLIENT_ID=
# Entra App registration Application (client) ID
FABRIC_CLIENT_SECRET=
# Entra app client secret VALUE (not the secret ID)
FABRIC_EVENTSTREAM_URL=
# Optional plain HTTPS ingest URL (rarely used for Fabric Custom endpoint)
FABRIC_EVENTHUB_CONNECTION_STRING=
# Paste "Connection string-primary key" from the Custom endpoint (keep secret)
FABRIC_EVENTHUB_NAME=
# Paste "Event hub name" from the Custom endpoint
FABRIC_WORKSPACE=GraphGuard_Fabric_Analytics
FABRIC_LAKEHOUSE=GraphGuard_Lakehouse
FABRIC_EVENTSTREAM_NAME=ES_GraphGuard_Lakehouse
# Exact Lakehouse table name for raw Eventstream ingest (must match Fabric)
FABRIC_INCOMING_TABLE=graphguard_incoming_events_stream_v5
# Read-only presence checks only (do not overwrite from the API)
FABRIC_PREDICTIONS_TABLE=realtime_fraud_predictions
FABRIC_TIMEOUT_SECONDS=10
FABRIC_MAX_RETRIES=2
# Background sync: Lakehouse incoming → LightGBM → PostgreSQL
FABRIC_SYNC_ENABLED=true
FABRIC_SYNC_INTERVAL_SECONDS=30

# Frontend build-time API URL (used by Compose web image build)
VITE_API_BASE_URL=http://localhost:8000
